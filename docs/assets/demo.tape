Output docs/assets/sharp-demo.gif

Require sharp

Set Shell "zsh"
Set FontSize 18
Set Width 1200
Set Height 720
Set Padding 20
Set Framerate 30
Set TypingSpeed 35ms
Set Theme "Catppuccin Mocha"

Type "sharp --theme sharp-color"
Enter
Sleep 2s
Type "t"
Sleep 1s
Down
Sleep 2s
Escape
Sleep 1s
Type "s"
Type "json"
Sleep 1s
Enter
Sleep 1s
Type "i"
Type '{"data":{"id":1,"name":"sharp"}}'
Sleep 2s
Escape
Sleep 1s
Type "]"
Sleep 1s
Ctrl+C
